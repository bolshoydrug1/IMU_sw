{
    // ── .vscode/settings.json — настройки VS Code, общие для проекта IMU_sw_1 ──
    // Личные настройки (путь к clangd.exe, пути к инструментам ST, тема)
    // остаются в пользовательских настройках и сюда не пишутся.
    // Комментарии в этом файле допустимы (формат JSONC).


    // ═══ CMake Tools: сборка по кнопке ═══

    // Брать конфигурации сборки из CMakePresets.json (пресеты Debug и Release).
    // Без этого расширение просит выбрать «Kit» (компилятор) вручную, а нужные
    // флаги, тулчейн-файл и каталог сборки уже описаны в пресетах.
    "cmake.useCMakePresets": "always",

    // Настраивать проект (запускать cmake) автоматически при открытии папки.
    // Так сразу появляется compile_commands.json, и подсветка clangd работает
    // после свежего клонирования, без ручного запуска настройки.
    "cmake.configureOnOpen": true,


    // ═══ clangd: переходы к объявлению, подсветка, автодополнение ═══
    // Язык C здесь обслуживает расширение ST «STM32Cube clangd»
    // (stm32cube-ide-clangd), поэтому ключи называются stm32cube-ide-clangd.*,
    // а не clangd.* (это настройки другого расширения, LLVM clangd).
    // Каталог с базой компиляции задан в файле .clangd (здесь не дублируется).
    // Путь к самому исполняемому файлу (stm32cube-ide-clangd.path) зависит от
    // машины и задаётся в пользовательских настройках, а не здесь.

    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=**/arm-none-eabi-gcc*"
    ],


    // ═══ Скрытие служебных каталогов ═══

    // Не показывать результаты сборки в поиске по проекту (Ctrl+Shift+F):
    // в них много копий кода, .map, .su и compile_commands.json.
    "search.exclude": {
        "**/build": true,
        "**/.cache": true,
        "**/Debug": true,
        "**/Firmware_TSM_*": true
    },

    // Не следить за изменениями в каталогах сборки и индекса clangd —
    // там тысячи файлов, наблюдение нагружает процессор впустую.
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.cache/**": true,
        "**/Debug/**": true
    },
    "cmake.cmakePath": "cmake",
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "stm32cube-ide-clangd.path": "cube"
}
