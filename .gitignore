# -----------------------------------------------------------
# Скомпилированные файлы и артефакты сборки (НЕ коммитить)
# -----------------------------------------------------------
*.o
*.obj
*.d
*.pdb
*.elf
*.hex
*.bin
*.map
*.list
*.lnp
*.srec
*.a
*.lib

# Папки сборки (по умолчанию в CubeIDE)
Debug/
Release/

# -----------------------------------------------------------
# Временные файлы редактора и резервные копии
# -----------------------------------------------------------
*~
*.bak
*.swp
*.swo
*.cproject~
*.project~
*.ioc~

# -----------------------------------------------------------
# Файлы операционной системы
# -----------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------
# Специфичные для Eclipse/CubeIDE (с осторожностью)
# -----------------------------------------------------------
# .launch файлы часто содержат абсолютные пути к отладчику.
# Если ваша команда использует одинаковую конфигурацию отладки,
# можно закомментировать следующую строку.
*.launch

# Папка .recommenders (кэш подсказок Eclipse)
.recommenders/

# -----------------------------------------------------------
# ВАЖНО: Что НУЖНО коммитить (не игнорируется)
# -----------------------------------------------------------
# .project
# .cproject
# .settings/ (папка с настройками компилятора)
# .ioc (файл конфигурации CubeMX)
# Core/, Drivers/, Middlewares/, Application/ (исходный код)
